{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "windows": [
      {
        "height": 900,
        "label": "main",
        "title": "NightCut",
        "width": 1440
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "Video",
    "copyright": "TheOwlOps",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "shortDescription": "Open-source video editor",
    "targets": "all"
  },
  "identifier": "com.theowlops.nightcut",
  "productName": "NightCut",
  "version": "0.1.0"
}